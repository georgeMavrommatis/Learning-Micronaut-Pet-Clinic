<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.gmavrommatis</groupId>
  <artifactId>pet-clinic</artifactId>
  <version>0.1</version>
  <packaging>${packaging}</packaging>

  <parent>
    <groupId>io.micronaut.platform</groupId>
    <artifactId>micronaut-parent</artifactId>
    <version>4.10.2</version>
  </parent>

  <!--Necessary for Centralized version alignment, enforcing versions from micronaut-platform BOM-->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.micronaut.platform</groupId>
        <artifactId>micronaut-platform</artifactId>
        <version>${micronaut.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <properties>
    <micronaut.version>4.10.2</micronaut.version>
    <packaging>jar</packaging>
    <jdk.version>21</jdk.version>
    <release.version>21</release.version>
    <micronaut.runtime>netty</micronaut.runtime>
    <micronaut.aot.enabled>false</micronaut.aot.enabled>
    <micronaut.aot.packageName>com.gmavrommatis.aot.generated</micronaut.aot.packageName>
    <exec.mainClass>com.gmavrommatis.Application</exec.mainClass>
    <mapstruct.version>1.6.3</mapstruct.version>
    <!--
    Specifies the location of your OpenAPI specification file.
    Micronaut reads this YAML/JSON file at compile time to generate models, API interfaces, and invokers.
    -->
    <micronaut.openapi.definition>src/main/resources/openapi/openapi.yml</micronaut.openapi.definition>
    <!--
    Defines the package where Micronaut will generate the **data models** (POJOs) corresponding to the schemas in your OpenAPI spec.
    -->
    <micronaut.openapi.model.package.name>com.gmavrommatis.model</micronaut.openapi.model.package.name>
    <!--
    Enables **server-side code generation**.
    Micronaut will generate API interfaces and server stubs based on the OpenAPI definition, so you don’t have to manually write controllers.
    -->
    <micronaut.openapi.generate.server>true</micronaut.openapi.generate.server>
    <!--
    Specifies the package where the **generated API interfaces** (controller-like interfaces) will be placed.
    These interfaces define all the endpoints, HTTP methods, parameters, and return types.
    -->
    <micronaut.openapi.api.package.name>com.gmavrommatis.api</micronaut.openapi.api.package.name>
    <!--
    Defines the package for the **invoker classes**.
    These are utility classes generated by Micronaut to help route requests from the controller interfaces to your implementation code.
    -->
    <micronaut.openapi.invoker.package.name>com.gmavrommatis.invoker</micronaut.openapi.invoker.package.name>
    <!--
    Determines whether the generated server code will include authentication scaffolding.
    Set to `false` if you don’t want security annotations or authentication handling automatically added.
    -->
    <micronaut.openapi.server.use.auth>false</micronaut.openapi.server.use.auth>
    <!--
    Specifies whether to generate **reactive endpoints** using `Publisher`/`Mono`/`Flux`.
    Set to `false` if you prefer standard blocking controllers.
    Set to `true` if you want reactive, non-blocking endpoints.
    -->
    <micronaut.openapi.use.reactive>true</micronaut.openapi.use.reactive>

  </properties>


  <repositories>
    <!-- A repository entry tells Maven where to look for dependency artifacts. -->
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>

  <dependencies>

    <!-- Lombok: Compile-time only -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--R2DBC-->

    <!--
    Full Micronaut Data support for R2DBC (reactive database access)
    Enables:
      Repository abstractions (CRUD, queries)
      Declarative @Repository interfaces
      Reactive return types (Mono, Flux) integrated with Micronaut
      Automatic mapping of entities to database rows
      Integrates with Micronaut's transaction management, so r2dbcTx.withTransaction() works
    -->
    <dependency>
      <groupId>io.micronaut.data</groupId>
      <artifactId>micronaut-data-r2dbc</artifactId>
    </dependency>

    <!--
    Provides a connection pool implementation for R2DBC
    Wraps a raw R2DBC driver (like r2dbc-postgresql) with:
      initialSize / maxSize control
      maxIdleTime, maxAcquireTime
      Connection reuse
      Integrates automatically with Micronaut Data R2DBC
    -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-pool</artifactId>
    </dependency>

    <!--
    Reactive PostgreSQL driver for R2DBC
    Implements the PostgreSQL protocol over TCP
    Supports:
      Fully reactive Mono/Flux queries
      Transactions
      Prepared statements, batch queries
      Backpressure support via reactive streams
    -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
      <version>0.8.13.RELEASE</version>
    </dependency>

    <!-- Provides Micronaut Data repositories for MongoDB with reactive support. -->
    <dependency>
      <groupId>io.micronaut.data</groupId>
      <artifactId>micronaut-data-mongodb</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Provides the core Micronaut integration with the reactive MongoDB driver.
         Supports configuration, connection pooling, and reactive transaction management
         for MongoDB within a Micronaut application. -->
    <dependency>
      <groupId>io.micronaut.mongodb</groupId>
      <artifactId>micronaut-mongo-reactive</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- The official MongoDB Reactive Streams Java driver.
         Provides non-blocking, asynchronous interaction with MongoDB.
         Works with reactive libraries like Reactor and RxJava. -->
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-reactivestreams</artifactId>
    </dependency>

    <!-- Reactor integration for Micronaut -->
    <dependency>
      <groupId>io.micronaut.reactor</groupId>
      <artifactId>micronaut-reactor</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Micronaut WebSocket dependency,
    provides support for building WebSocket clients and servers in a Micronaut application.
    provides the classes and annotations for WebSocket endpoints (@ServerWebSocket, @OnMessage, etc.).-->
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-websocket</artifactId>
    </dependency>

    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--aggregated jupiter artifact already brings in junit-jupiter-engine,
     plus the API and parameterized-test support, so we don’t need to
     declare junit-jupiter-engine separately-->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- MapStruct -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!--Jakarta validation-->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!--To expose controllers and HTTP routes-->
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http-server-netty</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.micronaut.serde</groupId>
      <artifactId>micronaut-serde-jackson</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--Client for Testing-->
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http-client</artifactId>
      <scope>test</scope>
    </dependency>

    <!--Testing-->
    <dependency>
      <groupId>io.micronaut.test</groupId>
      <artifactId>micronaut-test-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Swagger annotations -->
    <!-- Standard Swagger / OpenAPI annotations (io.swagger.v3.oas.annotations.*)
     - Provides the portable, vendor-neutral OpenAPI annotation types such as
       @Operation, @Parameter, @Schema, @ApiResponse, etc.
     - Use these on controllers, methods and DTOs to describe your API contract.
     - Needed at compile-time so your code can compile when you reference those annotations,
       and the annotation processor (micronaut-openapi) can read them to enrich the generated spec.-->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>${swagger.version}</version>
    </dependency>

    <!-- Micronaut OpenAPI annotations (runtime)
     - Adds Micronaut-specific annotations / integration helpers used by the Micronaut OpenAPI tooling.
     - These annotations (and small runtime bits) help Micronaut wire the generated OpenAPI spec into
       the application and, in some cases, supply extra metadata the generator expects.
     - Typically provided as a regular dependency (implementation/runtime) so the app has the annotation
       classes available at compile time and, if needed, at runtime.-->
    <dependency>
      <groupId>io.micronaut.openapi</groupId>
      <artifactId>micronaut-openapi-annotations</artifactId>
      <version>${micronaut.openapi.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.micronaut.maven</groupId>
        <artifactId>micronaut-maven-plugin</artifactId>
        <configuration>
          <configFile>aot-${packaging}.properties</configFile>
        </configuration>
      </plugin>
      <!--enforces rules and fail the build if policy is violated
      (wrong Java version, banned dependencies, mixed versions, missing plugin versions, etc.).-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Uncomment to enable incremental compilation -->
          <!-- <useIncrementalCompilation>false</useIncrementalCompilation> -->

          <annotationProcessorPaths combine.self="override">
            <!-- 1) Lombok must go first -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>

            <!-- 2) MapStruct -->
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>

            <!-- 3) Micronaut Inject (so bean-intro sees Lombok’s methods) -->
            <path>
              <groupId>io.micronaut</groupId>
              <artifactId>micronaut-inject-java</artifactId>
            </path>

            <!-- 4) Micronaut Serde -->
            <path>
              <groupId>io.micronaut.serde</groupId>
              <artifactId>micronaut-serde-processor</artifactId>
            </path>

            <!-- 5) Micronaut Data (if you’re using repositories) -->
            <path>
              <groupId>io.micronaut.data</groupId>
              <artifactId>micronaut-data-processor</artifactId>
            </path>

            <!-- Annotation processor for Micronaut Data -->
            <!-- Used at compile-time to generate repository implementations automatically.
                 Processes annotations like @Repository, @Query, and entity mappings.
                 Necessary for Micronaut Data to generate efficient, compile-time code
                 for MongoDB or other supported databases. -->
            <path>
              <groupId>io.micronaut.data</groupId>
              <artifactId>micronaut-data-document-processor</artifactId>
            </path>

            <!-- Including this allows other parts of the build (like plugins) to reference the Micronaut WebSocket library -->
            <path>
              <groupId>io.micronaut</groupId>
              <artifactId>micronaut-websocket</artifactId>
            </path>

            <!-- 6) Any other APTs you need (e.g. Micronaut HTTP validation) -->
            <path>
              <groupId>io.micronaut</groupId>
              <artifactId>micronaut-http-validation</artifactId>
            </path>

            <!-- Enable Micronaut’s annotation processors -->
            <path>
              <groupId>io.micronaut.validation</groupId>
              <artifactId>micronaut-validation-processor</artifactId>
            </path>


            <!-- Annotation processor / generator for Micronaut OpenAPI
                 - This is the **compile-time** processor that scans code and swagger/micronaut annotations
                   and generates the OpenAPI spec files (e.g. META-INF/swagger/openapi.yml) and the Swagger UI
                   views into your build output.
                 - It must be available to the Java compiler (javac) as an annotation processor.
                 - Without this artifact on the compiler's processor path, OpenAPI YAML/JSON won't be generated.-->
            <path>
              <groupId>io.micronaut.openapi</groupId>
              <artifactId>micronaut-openapi</artifactId>
              <version>${micronaut.openapi.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amicronaut.processing.group=com.gmavrommatis</arg>
            <arg>-Amicronaut.processing.module=pet-clinic</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.5</version>
        <configuration>
          <!-- only format your Java sources -->
          <includes>
            <include>src/main/java/**/*.java</include>
            <include>src/test/java/**/*.java</include>
          </includes>
          <java>
            <!-- pick your formatter: googleJavaFormat, eclipse, prettier, etc. -->
            <googleJavaFormat/>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- bind `apply` to the process-sources phase so it automatically rewrites -->
            <phase>process-sources</phase>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--Copy openapi.yml under target resources to be available in swagger ui,
      or use http://localhost:8080/swagger-ui/index.html?url=openapi.yml with request parameter
      the file yml location under project-->
      <plugin>
        <!-- Maven plugin for copying resources during the build -->
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <!-- Identifier for this specific execution -->
            <id>copy-openapi</id>

            <!-- Phase of the Maven build lifecycle when this execution runs -->
            <phase>process-resources</phase>

            <!-- The goal of the plugin to execute -->
            <goals>
              <goal>copy-resources</goal> <!-- copy resources from one location to another -->
            </goals>

            <configuration>
              <!-- Destination directory where the OpenAPI spec will be copied -->
              <outputDirectory>${project.build.outputDirectory}/META-INF/swagger</outputDirectory>

              <resources>
                <resource>
                  <!-- Source directory where your OpenAPI YAML is generated -->
                  <directory>${project.basedir}/src/main/resources/openapi/</directory> <!-- replace with actual path if needed -->
                  <filtering>false</filtering>
                  <!--<includes>
                    &lt;!&ndash; Specify which files to copy &ndash;&gt;
                    <include>openapi.yml</include> &lt;!&ndash; only copy openapi.yml &ndash;&gt;
                  </includes>-->
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--removing the unused autogenerated openapi.yml-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>delete-swagger-root-yml</id>
            <phase>prepare-package</phase> <!-- after Micronaut generates the file -->
            <configuration>
              <target>
                <!-- Force deletion of the generated yml in project root -->
                <delete file="${basedir}/openapi.yml" failonerror="false"/>
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
